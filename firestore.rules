rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.get('phone_number', '') == '+17654794230';
    }
    function validPackId(packId) {
      return packId in ['basic', 'plus', 'premium', 'elite', 'ultimate', 'mythic', 'icy-rush'];
    }
    function validContents(packId) {
      let data = request.resource.data;
      return data.keys().hasAll(['items', 'enabled', 'version', 'totalChanceBps', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['items', 'enabled', 'version', 'totalChanceBps', 'updatedBy', 'updatedAt', 'priceCents'])
        && data.items is list && data.items.size() > 0 && data.items.size() <= 1000
        && data.enabled is bool
        && (!data.keys().hasAny(['priceCents']) || data.priceCents == null
          || (data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 100000000))
        && (!(packId in ['icy-rush','mythic']) || !data.enabled || (data.get('priceCents', null) is int))
        && data.version is int && data.version > 0
        && data.totalChanceBps == 10000
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }
    // Catalogs are public display data. All writes require the verified owner.
    match /packContents/{packId} {
      allow get, list: if validPackId(packId);
      allow create: if validPackId(packId) && owner() && validContents(packId) && request.resource.data.version == 1;
      allow update: if validPackId(packId) && owner() && validContents(packId) && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
    match /rewardSettings/{id} {
      allow get: if id in ['daily','spark'];
      allow list, write: if false;
    }
    match /settings/homepageGrails {
      allow get: if true;
      // Full six-card validation and optimistic versioning run in the owner-only
      // ripprAccount saveHomepageGrails action, outside the Rules expression cap.
      allow list, write: if false;
    }
    // Server-only delivery records may contain private account details and links.
    match /emailOutbox/{id} { allow read, write: if false; }
    match /stripeTestWebhookEvents/{id} { allow read, write: if false; }
    match /paymentReviewQueue/{document=**} { allow read, write: if false; }
    match /paymentReviewAudit/{document=**} { allow read, write: if false; }
    match /paymentAuditByAccount/{document=**} { allow read, write: if false; }
    match /liveAccounts/{document=**} { allow read, write: if false; }
    // Private reusable catalog. Each record is independent of pack prices/odds.
    function validLibraryCard(cardId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','nameKey','image','setName','number','finish','source','sourceId','sourceRarity','referenceURL','rarity','valueCents','version','updatedBy','updatedAt'])
        && d.keys().hasOnly(['id','name','nameKey','image','setName','number','finish','source','sourceId','sourceRarity','referenceURL','rarity','valueCents','grading','version','updatedBy','updatedAt','createdAt'])
        && (d.get('createdAt', null) == null || d.createdAt is timestamp)
        && cardId.matches('[a-zA-Z0-9_-]{1,64}') && d.id == cardId
        && d.name is string && d.name.trim().size() > 0 && d.name.size() <= 100
        && d.nameKey is string && d.nameKey.size() > 0 && d.nameKey.size() <= 200
        && d.image is string && d.image.size() <= 2048
        && ((d.image.matches('assets/[a-zA-Z0-9/_.-]+') && !d.image.matches('.*\\.\\..*')) || d.image.matches('https://[^/ @]+(/[^ ]*)?'))
        && d.setName is string && d.setName.size() <= 120
        && d.number is string && d.number.size() <= 30
        && d.finish is string && d.finish.trim().size() > 0 && d.finish.size() <= 60
        && d.source in ['manual','tcgdex','pack']
        && d.sourceId is string && d.sourceId.size() <= 80
        && d.sourceRarity is string && d.sourceRarity.size() <= 80
        && d.referenceURL is string && d.referenceURL.size() <= 2048
        && (d.referenceURL == '' || d.referenceURL.matches('https://(www\\.)?tcgplayer\\.com(/[^ ]*)?'))
        && (d.rarity == null || d.rarity in ['Common','Uncommon','Rare','Ultra rare','Special rare','Epic','Legendary'])
        && (d.valueCents == null || (d.valueCents is int && d.valueCents >= 0 && d.valueCents <= 100000000))
        && validGrading(d)
        && d.version is int && d.version > 0
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /cardLibrary/{cardId} {
      allow read: if owner();
      allow create: if owner() && validLibraryCard(cardId) && request.resource.data.version == 1
        && (request.resource.data.get('createdAt', null) == null || request.resource.data.createdAt == request.time);
      allow update: if owner() && validLibraryCard(cardId) && request.resource.data.version == resource.data.version + 1
        && (resource.data.get('createdAt', null) != null
          ? request.resource.data.get('createdAt', null) == resource.data.createdAt
          : (request.resource.data.get('createdAt', null) == null
            || (resource.data.version == 1 && request.resource.data.createdAt == resource.data.updatedAt)));
      allow delete: if false;
    }
    // Free test balances and winnings are written exclusively by callable Functions.
    // Members may inspect only their own records; no browser can mint credit/items.
    // DOB and consent audit records are served only through authenticated Functions.
    match /accountEligibility/{document=**} { allow read, write: if false; }
    match /accountClosureRequests/{document=**} { allow read, write: if false; }
    match /accountClosureState/{document=**} { allow read, write: if false; }
    function readableAccount(uid) {
      return request.auth != null && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/accountClosureState/$(uid))
          || get(/databases/$(database)/documents/accountClosureState/$(uid)).data.status != 'completed');
    }
    match /testAccounts/{uid} {
      allow read: if readableAccount(uid);
      allow write: if false;
      match /{document=**} {
        allow read: if readableAccount(uid);
        allow write: if false;
      }
    }
    match /liveAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/liveAccountClosureState/$(uid))
          || get(/databases/$(database)/documents/liveAccountClosureState/$(uid)).data.status != 'completed');
      allow write: if false;
      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid
          && (!exists(/databases/$(database)/documents/liveAccountClosureState/$(uid))
            || get(/databases/$(database)/documents/liveAccountClosureState/$(uid)).data.status != 'completed');
        allow write: if false;
      }
    }
    // Museum drafts, directory projections and per-account likes are served by
    // ripprMuseum, which verifies publication, ownership and authoritative counts.
    match /museumDirectory/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
