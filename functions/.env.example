# Free test credit only. Set false and redeploy the Function to pause top-ups.
FREE_TEST_TOPUPS=true

# Transactional email. Keep off until the domain and secret are configured.
EMAIL_ENABLED=false
EMAIL_SITE_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
# RESEND_API_KEY goes in Firebase Secret Manager, never this file.

# Stripe sandbox only; live keys/payments are deliberately rejected.
STRIPE_TEST_TOPUPS_ENABLED=false
STRIPE_SITE_URL=https://www.rippr.gg
# Do not guess whether stored credit is taxed at funding or redemption.
STRIPE_TOPUP_AUTOMATIC_TAX=false
STRIPE_TOPUP_TAX_CODE=
# STRIPE_TEST_SECRET_KEY and STRIPE_TEST_WEBHOOK_SECRET belong in Secret Manager.

# Separate live storefront (off by default). Store keys with functions:secrets:set,
# never in this file. See docs/LIVE-MODE.md and scripts/configure-live.mjs.
SITE_MODE=test
STRIPE_LIVE_TOPUPS_ENABLED=false
LIVE_PURCHASES_ENABLED=false
LIVE_PUBLIC_ACCESS=false
