{
  "name": "rippr",
  "version": "1.0.0",
  "private": true,
  "description": "rippr single-card pack openings and Firebase Authentication",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "python3 -m http.server 3000 --bind 127.0.0.1 --directory dist",
    "emulators": "firebase emulators:start --only auth --project demo-rippr",
    "deploy": "npm run build && firebase deploy --only hosting --project rippr-2b01c"
  },
  "dependencies": { "firebase": "13.2.0" },
  "devDependencies": { "esbuild": "0.28.2", "firebase-tools": "15.35.0" }
}
