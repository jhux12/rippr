{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/rewards",
      "destination": "/rewards.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/shipping",
      "destination": "/shipping.html"
    },
    {
      "source": "/order-tracking",
      "destination": "/order-tracking.html"
    },
    {
      "source": "/account-settings",
      "destination": "/account-settings.html"
    },
    {
      "source": "/help-center",
      "destination": "/help-center.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact-support",
      "destination": "/contact-support.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/museum",
      "destination": "/museum.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/payment-success",
      "destination": "/payment-success.html"
    },
    {
      "source": "/payment-canceled",
      "destination": "/payment-canceled.html"
    }
  ]
}
