{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/rewards",
      "destination": "/rewards.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/shipping",
      "destination": "/shipping.html"
    },
    {
      "source": "/order-tracking",
      "destination": "/order-tracking.html"
    },
    {
      "source": "/account-settings",
      "destination": "/account-settings.html"
    }
  ]
}
