{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/rewards",
        "destination": "/rewards.html"
      },
      {
        "source": "/how-it-works",
        "destination": "/how-it-works.html"
      },
      {
        "source": "/shipping",
        "destination": "/shipping.html"
      },
      {
        "source": "/order-tracking",
        "destination": "/order-tracking.html"
      },
      {
        "source": "/account-settings",
        "destination": "/account-settings.html"
      },
      {
        "source": "/help-center",
        "destination": "/help-center.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/contact-support",
        "destination": "/contact-support.html"
      },
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "/museum",
        "destination": "/museum.html"
      },
      {
        "source": "/community",
        "destination": "/community.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/landing/",
        "destination": "/landing",
        "type": 302
      },
      {
        "source": "/museum/",
        "destination": "/museum",
        "type": 302
      },
      {
        "source": "/community/",
        "destination": "/community",
        "type": 302
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build:functions"
    ]
  }
}
