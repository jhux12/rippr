rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner() {
      return request.auth != null
        && request.auth.token.get('phone_number', '') == '+17654794230';
    }
    match /card-images/{filename} {
      allow read: if true;
      allow create: if owner() && filename.matches('[a-zA-Z0-9-]+\\.(jpg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Uploaded image URLs are immutable, so existing published art cannot be overwritten.
      allow update, delete: if false;
    }
    match /homepage-grails/{filename} {
      allow read: if true;
      allow create: if owner() && filename.matches('[a-zA-Z0-9-]+\\.(jpg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // New uploads get new names; published homepage images remain immutable.
      allow update, delete: if false;
    }
    match /profile-images/{uid}/{filename} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && filename.matches('[a-zA-Z0-9-]+\\.(jpg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /support-attachments/{uid}/{ticketId}/{filename} {
      allow read: if request.auth != null && (request.auth.uid == uid || owner());
      allow create: if request.auth != null && request.auth.uid == uid
        && ticketId.matches('[a-zA-Z0-9-]{16,80}')
        && ((filename == 'screenshot.png' && request.resource.contentType == 'image/png')
          || (filename == 'screenshot.jpg' && request.resource.contentType == 'image/jpeg'))
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
